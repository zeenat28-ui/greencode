# ==============================================================================
# GreenCode Auditor - Environment Configuration Template
#
#   cp .env.example .env
#
# Then FILL IN EVERY VALUE MARKED <REQUIRED>. The compose file refuses to start
# without them (`:?` in docker-compose.yml), so there is no silently-insecure
# default left to inherit.
#
# Generate the three secrets, do not invent them:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"                      # JWT_SECRET
#   python -c "import secrets; print(secrets.token_urlsafe(32))"                      # POSTGRES_PASSWORD, REDIS_PASSWORD
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"  # SECRETS_ENCRYPTION_KEY
# ==============================================================================

# --- Required secrets --------------------------------------------------------
ENV=production

# Signs every access token (HS256). Must be >= 32 chars. The service exits at
# startup in production if this is missing, default, or short.
JWT_SECRET=<REQUIRED - python -c "import secrets; print(secrets.token_urlsafe(48))">

# Fernet key for encrypting user GitHub tokens at rest. Rotating this makes
# previously stored tokens undecryptable and those users must re-authenticate.
SECRETS_ENCRYPTION_KEY=<REQUIRED - python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())">

BCRYPT_ROUNDS=12

# --- Database ----------------------------------------------------------------
# These four values must match what docker-compose.yml passes to the services.
# The previous template shipped a URL (greencode:greencode_pass@localhost) that
# disagreed with the compose file (greencode_user:...@postgres), so following
# the documented setup produced a deployment that could not connect.
POSTGRES_DB=greencode
POSTGRES_USER=greencode_user
POSTGRES_PASSWORD=<REQUIRED - python -c "import secrets; print(secrets.token_urlsafe(32))">
POSTGRES_PORT=5432

# Host-run (non-container) development uses localhost; containers use the
# service name. Keep this pair in sync with POSTGRES_USER/POSTGRES_PASSWORD above.
DATABASE_URL=postgresql://greencode_user:CHANGE_ME@localhost:5432/greencode
SYNC_DATABASE_URL=postgresql://greencode_user:CHANGE_ME@localhost:5432/greencode

# --- Redis / Celery ----------------------------------------------------------
REDIS_PASSWORD=<REQUIRED - python -c "import secrets; print(secrets.token_urlsafe(32))">
REDIS_PORT=6379
REDIS_URL=redis://:CHANGE_ME@localhost:6379/0
CELERY_BROKER_URL=redis://:CHANGE_ME@localhost:6379/0
CELERY_RESULT_BACKEND=redis://:CHANGE_ME@localhost:6379/0

# --- Published ports ---------------------------------------------------------
# Every published port is bound to loopback by default. Set *_BIND=0.0.0.0 only
# when a deliberate external exposure is in place behind a firewall.
BACKEND_BIND=127.0.0.1
BACKEND_PORT=8000
FRONTEND_BIND=127.0.0.1
FRONTEND_PORT=8501
WEB_BIND=127.0.0.1
WEB_PORT=3000

# --- CORS --------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://localhost:8080


# --- HuggingFace Inference API (model-assisted refactoring) ---
# Optional. Without a key the deterministic GreenCode rule engine still produces
# every refactor; the model is only consulted for rules the engine has no
# pattern-specific transformation for, and every model proposal is verified
# (compiles + behaviour-preserving) before being shown.
# Create a read token at https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=

# --- Electricity Maps (optional) ---
ELECTRICITY_MAPS_API_KEY=

# --- SMTP / Email (optional) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@greencode.dev

# --- App ---
APP_URL=http://localhost:3000

# --- GitHub ---
# Personal Access Token used only for CI (PR creation, private repo inspection).
# End users supply their own token through the Settings page; it is encrypted at
# rest with SECRETS_ENCRYPTION_KEY.
GITHUB_TOKEN=ghp_your_github_personal_access_token_here
GITHUB_USER=your_github_username

# Default Regional Grid Zone (e.g. US-CAL-CISO, DE, FR, GB, SG, IN-WE, PK, AU-NSW)
DEFAULT_ZONE=US-CAL-CISO

# ==============================================================================
# Reality Verification Pipeline
# Answers "did the optimisation actually work on real hardware?".
# Without a secret, evidence intake is unauthenticated, so the ledger - the record
# of what was decided and on what evidence - would be forgeable.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# ==============================================================================
GREENCODE_PIPELINE_WEBHOOK_SECRET=
# Set to false wherever ledger integrity matters. Production refuses unsigned
# intake outright and reports the misconfiguration via /api/pipeline/status.
GREENCODE_PIPELINE_ALLOW_UNSIGNED=true
# Reject evidence signed more than this many seconds ago (replay protection).
GREENCODE_PIPELINE_MAX_SKEW_SECONDS=300

# --- Verification policy ------------------------------------------------------
# Allowed gap between predicted and observed energy reduction, in percent.
GREENCODE_PIPELINE_TOLERANCE_PCT=15.0
# Hardware-measured runs required before a claim can reach VERIFIED.
GREENCODE_PIPELINE_MIN_SAMPLES=3
# Run-to-run spread above which the workload is too noisy to verify.
GREENCODE_PIPELINE_MAX_SPREAD_PCT=20.0

# --- Notification channels ----------------------------------------------------
# At least one is required in production; otherwise verdicts are recorded but
# never reach an operator, which is a silent failure.
GREENCODE_PIPELINE_SLACK_WEBHOOK=
GREENCODE_PIPELINE_TEAMS_WEBHOOK=
GREENCODE_PIPELINE_NOTIFY_EMAIL=
GREENCODE_PIPELINE_HTTP_TIMEOUT_SECONDS=8.0
GREENCODE_PIPELINE_MAX_RETRIES=2

# Docker Host URI (DinD TCP proxy, physical UNIX socket, or Windows named pipe)
# DOCKER_HOST=tcp://dind-service:2375
# DOCKER_HOST=unix:///var/run/docker.sock
