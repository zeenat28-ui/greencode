# ==============================================================================
# GreenCode Auditor - Environment Configuration Template
# Copy this file to '.env' and populate your API credentials.
# ==============================================================================

# --- Core ---
ENV=development
SECRETS_ENCRYPTION_KEY=change-me-to-a-long-random-string-32chars-or-more  # Required for Fernet column encryption
JWT_SECRET=change-me-at-least-64-chars-long-crypto-random             # Do NOT use the default
BCRYPT_ROUNDS=12

# --- CORS ---
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080

# --- Database ---
DATABASE_URL=postgresql://greencode:greencode_pass@localhost:5432/greencode

# --- Redis / Celery ---
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# --- HuggingFace Inference API (model-assisted refactoring) ---
# Optional. Without a key the deterministic GreenCode rule engine still produces
# every refactor; the model is only consulted for rules the engine has no
# pattern-specific transformation for, and every model proposal is verified
# (compiles + behaviour-preserving) before being shown.
# Create a read token at https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=

# --- Electricity Maps (optional) ---
ELECTRICITY_MAPS_API_KEY=

# --- SMTP / Email (optional) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@greencode.dev

# --- App ---
APP_URL=http://localhost:3000

# --- GitHub ---
# Personal Access Token used only for CI (PR creation, private repo inspection).
# End users supply their own token through the Settings page; it is encrypted at
# rest with SECRETS_ENCRYPTION_KEY.
GITHUB_TOKEN=ghp_your_github_personal_access_token_here
GITHUB_USER=your_github_username

# Default Regional Grid Zone (e.g. US-CAL-CISO, DE, FR, GB, SG, IN-WE, PK, AU-NSW)
DEFAULT_ZONE=US-CAL-CISO

# Celery and Redis Task Queue Broker URL
REDIS_URL=redis://localhost:6379/0

# ==============================================================================
# Reality Verification Pipeline
# Answers "did the optimisation actually work on real hardware?".
# Without a secret, evidence intake is unauthenticated, so the ledger - the record
# of what was decided and on what evidence - would be forgeable.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# ==============================================================================
GREENCODE_PIPELINE_WEBHOOK_SECRET=
# Set to false wherever ledger integrity matters. Production refuses unsigned
# intake outright and reports the misconfiguration via /api/pipeline/status.
GREENCODE_PIPELINE_ALLOW_UNSIGNED=true
# Reject evidence signed more than this many seconds ago (replay protection).
GREENCODE_PIPELINE_MAX_SKEW_SECONDS=300

# --- Verification policy ------------------------------------------------------
# Allowed gap between predicted and observed energy reduction, in percent.
GREENCODE_PIPELINE_TOLERANCE_PCT=15.0
# Hardware-measured runs required before a claim can reach VERIFIED.
GREENCODE_PIPELINE_MIN_SAMPLES=3
# Run-to-run spread above which the workload is too noisy to verify.
GREENCODE_PIPELINE_MAX_SPREAD_PCT=20.0

# --- Notification channels ----------------------------------------------------
# At least one is required in production; otherwise verdicts are recorded but
# never reach an operator, which is a silent failure.
GREENCODE_PIPELINE_SLACK_WEBHOOK=
GREENCODE_PIPELINE_TEAMS_WEBHOOK=
GREENCODE_PIPELINE_NOTIFY_EMAIL=
GREENCODE_PIPELINE_HTTP_TIMEOUT_SECONDS=8.0
GREENCODE_PIPELINE_MAX_RETRIES=2

# Docker Host URI (DinD TCP proxy, physical UNIX socket, or Windows named pipe)
# DOCKER_HOST=tcp://dind-service:2375
# DOCKER_HOST=unix:///var/run/docker.sock
