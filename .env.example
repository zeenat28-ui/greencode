# ==============================================================================
# GreenCode Auditor - Environment Configuration Template
# Copy this file to '.env' and populate your API credentials.
# ==============================================================================

# Electricity Maps Real-Time Grid Carbon API Key
ELECTRICITY_MAPS_API_KEY=your_electricity_maps_api_token_here

# HuggingFace Inference API Token (Used for IBM Granite 3.2 Eco-Refactoring)
HUGGINGFACE_TOKEN=hf_your_huggingface_read_token_here

# IBM Bob 2.0 Direct Orchestration Key (Alternative to HuggingFace)
IBM_BOB_API_KEY=your_ibm_bob_api_key_here

# GitHub Personal Access Token (for PR creation and private repo inspection)
GITHUB_TOKEN=ghp_your_github_personal_access_token_here
GITHUB_USER=your_github_username

# Default Regional Grid Zone (e.g. US-CAL-CISO, DE, FR, GB, SG, IN-WE, PK, AU-NSW)
DEFAULT_ZONE=US-CAL-CISO

# High-Concurrency Database URL (Postgres in production, SQLite in local dev)
DATABASE_URL=sqlite+aiosqlite:///greencode.db
SYNC_DATABASE_URL=sqlite:///greencode.db
# DATABASE_URL=postgresql+asyncpg://greencode_user:password@localhost:5432/greencode
# SYNC_DATABASE_URL=postgresql://greencode_user:password@localhost:5432/greencode

# Celery and Redis Task Queue Broker URL
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Docker Host URI (DinD TCP proxy, physical UNIX socket, or Windows named pipe)
# DOCKER_HOST=tcp://dind-service:2375
# DOCKER_HOST=unix:///var/run/docker.sock

