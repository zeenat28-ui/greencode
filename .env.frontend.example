# Frontend Environment Configuration
# Copy to .env.frontend before deploying.

VITE_API_URL=http://localhost:8000
VITE_APP_NAME=GreenCode
VITE_APP_VERSION=2.1.0

# --- Vercel Deployment ---
# When deploying the frontend on Vercel, set these in the Vercel dashboard
# (Project Settings > Environment Variables), NOT in .env.frontend:
#
#   VITE_API_URL     - The full backend URL, e.g. https://api.your-domain.com
#                      (If left unset/empty, the SPA makes relative /api calls
#                       and vercel.json rewrites them via BACKEND_URL.)
#   BACKEND_URL      - The backend origin that vercel.json rewrites /api and
#                      /github to, e.g. https://api.your-domain.com
#
# Required: A deployed FastAPI backend (Docker Compose or container service).
# The frontend cannot function without the backend API.
