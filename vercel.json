{
  "version": 2,
  "buildCommand": "cd frontend && npm run build",
  "outputDirectory": "frontend/dist",
  "installCommand": "cd frontend && npm install --legacy-peer-deps",
  "framework": null,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.py"
    },
    {
      "src": "/github/(.*)",
      "dest": "/api/index.py"
    },
    {
      "src": "/alexa/skill",
      "dest": "/api/index.py"
    },
    {
      "src": "/api/alexa/skill",
      "dest": "/api/index.py"
    },
    {
      "src": "/mcp",
      "dest": "/api/index.py"
    },
    {
      "src": "/_vercel/health",
      "dest": "/api/index.py"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Credentials",
          "value": "true"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "https://greencode-teal.vercel.app"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET,POST,PUT,DELETE,OPTIONS"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "Authorization,Content-Type,Accept,X-GitHub-Token"
        },
        {
          "key": "Vary",
          "value": "Origin"
        }
      ]
    }
  ]
}