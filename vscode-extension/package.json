{
  "name": "greencode-energy-linter",
  "displayName": "GreenCode - Energy & Carbon Linter",
  "description": "Real-time 13-language AST energy linter, SCI carbon tracker, and 1-click Quick Fix refactoring for VS Code.",
  "version": "2.0.0",
  "publisher": "greencode",
  "repository": {
    "type": "git",
    "url": "https://github.com/zeenat28-ui/greencode.git"
  },
  "license": "Apache-2.0",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Linters",
    "Programming Languages",
    "Other"
  ],
  "activationEvents": [
    "onLanguage:python",
    "onLanguage:javascript",
    "onLanguage:typescript",
    "onLanguage:go",
    "onLanguage:rust",
    "onLanguage:java",
    "onLanguage:c",
    "onLanguage:cpp",
    "onLanguage:csharp",
    "onLanguage:ruby",
    "onLanguage:php",
    "onLanguage:shellscript",
    "onLanguage:sql"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "greencode.lintWorkspace",
        "title": "GreenCode: Audit Current File for Energy Inefficiencies"
      },
      {
        "command": "greencode.showEnergyDebt",
        "title": "GreenCode: Show Live Team Carbon Budget & Energy Debt"
      },
      {
        "command": "greencode.applyQuickFix",
        "title": "GreenCode: Refactor Flagged Block via Live AST / Bedrock Engine"
      }
    ],
    "configuration": {
      "title": "GreenCode",
      "properties": {
        "greencode.apiUrl": {
          "type": "string",
          "default": "http://localhost:8000",
          "description": "GreenCode API Base URL for live diagnostic telemetry and refactoring"
        },
        "greencode.enableRealTimeLinting": {
          "type": "boolean",
          "default": true,
          "description": "Enable instant inline energy diagnostics while editing"
        }
      }
    }
  }
}
